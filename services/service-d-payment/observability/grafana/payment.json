{
  "uid": "cloudstore-service-d",
  "title": "CloudStore — Service D Payment",
  "schemaVersion": 39,
  "version": 2,
  "tags": [
    "cloudstore",
    "service-d",
    "RED"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1
      },
      {
        "name": "loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "refresh": 1
      },
      {
        "name": "jaeger",
        "label": "Jaeger",
        "type": "datasource",
        "query": "jaeger",
        "refresh": 1
      },
      {
        "name": "trace_id",
        "label": "Trace ID (vide = tous les logs)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Payment Rate",
      "description": "All payment HTTP requests, including idempotent replays.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"service-d-payment\",route=\"/payments/charge\",method=\"POST\"}[$__rate_interval]))",
          "legendFormat": "requests/s",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "links": [
            {
              "title": "Logs D — même fenêtre temporelle (pas une trace précise)",
              "url": "/d/cloudstore-service-d?${__url_time_range}&var-trace_id=&viewPanel=9",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Payment Errors by HTTP status",
      "description": "402 = refusal, 400 = invalid request, 409 = idempotency conflict; 5xx = technical failure.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_code) (rate(http_requests_total{job=\"service-d-payment\",route=\"/payments/charge\",method=\"POST\",status_code=~\"4..|5..\"}[$__rate_interval]))",
          "legendFormat": "HTTP {{status_code}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "links": [
            {
              "title": "Logs D — même fenêtre temporelle (pas une trace précise)",
              "url": "/d/cloudstore-service-d?${__url_time_range}&var-trace_id=&viewPanel=9",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Payment Duration p50 / p95 / p99",
      "description": "Latency of HTTP responses, including fast idempotent replays. Histogram quantiles are estimates; this is not PSP-only latency.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"service-d-payment\",route=\"/payments/charge\",method=\"POST\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"service-d-payment\",route=\"/payments/charge\",method=\"POST\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"service-d-payment\",route=\"/payments/charge\",method=\"POST\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "links": [
            {
              "title": "Logs D — même fenêtre temporelle (pas une trace précise)",
              "url": "/d/cloudstore-service-d?${__url_time_range}&var-trace_id=&viewPanel=9",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Payment HTTP outcomes",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_code) (rate(http_requests_total{job=\"service-d-payment\",route=\"/payments/charge\",method=\"POST\"}[$__rate_interval]))",
          "legendFormat": "HTTP {{status_code}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "links": [
            {
              "title": "Logs D — même fenêtre temporelle (pas une trace précise)",
              "url": "/d/cloudstore-service-d?${__url_time_range}&var-trace_id=&viewPanel=9",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Payment technical failure ratio",
      "description": "5xx / all payment HTTP responses over 5m. Ratio 0..1, formatted as 0..100%; no traffic = no data. Includes replays, 400/402/409 in denominator.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum(increase(http_requests_total{job=\"service-d-payment\",route=\"/payments/charge\",method=\"POST\",status_code=~\"5..\"}[5m])) or vector(0)) / sum(increase(http_requests_total{job=\"service-d-payment\",route=\"/payments/charge\",method=\"POST\"}[5m]))) and on() (sum(increase(http_requests_total{job=\"service-d-payment\",route=\"/payments/charge\",method=\"POST\"}[5m])) > 0)",
          "legendFormat": "5xx / all",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "links": [
            {
              "title": "Logs D — même fenêtre temporelle (pas une trace précise)",
              "url": "/d/cloudstore-service-d?${__url_time_range}&var-trace_id=&viewPanel=9",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Payment requests in selected range",
      "description": "Estimated increase over the selected time range; counts requests, not unique charges.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_code) (increase(http_requests_total{job=\"service-d-payment\",route=\"/payments/charge\",method=\"POST\"}[$__range]))",
          "legendFormat": "HTTP {{status_code}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "links": [
            {
              "title": "Logs D — même fenêtre temporelle (pas une trace précise)",
              "url": "/d/cloudstore-service-d?${__url_time_range}&var-trace_id=&viewPanel=9",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Payment mean HTTP duration",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_request_duration_seconds_sum{job=\"service-d-payment\",route=\"/payments/charge\",method=\"POST\"}[$__rate_interval])) / clamp_min(sum(rate(http_request_duration_seconds_count{job=\"service-d-payment\",route=\"/payments/charge\",method=\"POST\"}[$__rate_interval])),0.000001)",
          "legendFormat": "mean",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "links": [
            {
              "title": "Logs D — même fenêtre temporelle (pas une trace précise)",
              "url": "/d/cloudstore-service-d?${__url_time_range}&var-trace_id=&viewPanel=9",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Service D scrape availability",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"service-d-payment\"}",
          "legendFormat": "UP",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "links": [
            {
              "title": "Logs D — même fenêtre temporelle (pas une trace précise)",
              "url": "/d/cloudstore-service-d?${__url_time_range}&var-trace_id=&viewPanel=9",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Payment JSON logs — inspect trace_id / span_id",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"service-d-payment\"} | json | trace_id=~\"${trace_id:regex}.*\"",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          }
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "description": "Cliquer sur un lien dérivé trace_id pour ouvrir la vue unifiée ou la trace Jaeger exacte. Le champ Trace ID filtre les logs et le panneau de trace."
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Availability SLI — 30d",
      "description": "Proxy de disponibilité HTTP : proportion de scrapes réussis. Fenêtre cible 30j, limitée à l'historique disponible. Objectif démo ≥99,9%.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(avg_over_time(up{job=\"service-d-payment\"}[30d]))",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "noValue": "Pas de données / trafic insuffisant",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          },
          "links": [
            {
              "title": "Logs D — même fenêtre temporelle (pas une trace précise)",
              "url": "/d/cloudstore-service-d?${__url_time_range}&var-trace_id=&viewPanel=9",
              "targetBlank": false
            }
          ],
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Technical errors SLI — 5m",
      "description": "5xx / toutes réponses paiement, au moins 20 requêtes sur 5m. Objectif démo strictement <1%.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 8,
        "y": 32,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum(increase(http_requests_total{job=\"service-d-payment\",route=\"/payments/charge\",method=\"POST\",status_code=~\"5..\"}[5m])) or vector(0)) / sum(increase(http_requests_total{job=\"service-d-payment\",route=\"/payments/charge\",method=\"POST\"}[5m]))) and on() (sum(increase(http_requests_total{job=\"service-d-payment\",route=\"/payments/charge\",method=\"POST\"}[5m])) >= 20)",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "noValue": "Pas de données / trafic insuffisant",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          },
          "links": [
            {
              "title": "Logs D — même fenêtre temporelle (pas une trace précise)",
              "url": "/d/cloudstore-service-d?${__url_time_range}&var-trace_id=&viewPanel=9",
              "targetBlank": false
            }
          ],
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Payment p95 SLI — 5m",
      "description": "Latence HTTP de paiement, rejeux compris ; au moins 20 requêtes sur 5m. Objectif démo strictement <500ms.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 16,
        "y": 32,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"service-d-payment\",route=\"/payments/charge\",method=\"POST\"}[5m])))) and on() (sum(increase(http_requests_total{job=\"service-d-payment\",route=\"/payments/charge\",method=\"POST\"}[5m])) >= 20)",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "Pas de données / trafic insuffisant",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "links": [
            {
              "title": "Logs D — même fenêtre temporelle (pas une trace précise)",
              "url": "/d/cloudstore-service-d?${__url_time_range}&var-trace_id=&viewPanel=9",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Payment success rate — business outcomes",
      "description": "200 / (200+402), réponses métier seulement, rejeux inclus. Refus 402 distincts des erreurs 5xx. Aucun objectif contractuel de succès PSP fictif.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum(increase(http_requests_total{job=\"service-d-payment\",route=\"/payments/charge\",method=\"POST\",status_code=\"200\"}[5m])) or vector(0)) / sum(increase(http_requests_total{job=\"service-d-payment\",route=\"/payments/charge\",method=\"POST\",status_code=~\"200|402\"}[5m]))) and on() (sum(increase(http_requests_total{job=\"service-d-payment\",route=\"/payments/charge\",method=\"POST\",status_code=~\"200|402\"}[5m])) > 0)",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "noValue": "Pas de données / trafic insuffisant",
          "links": [
            {
              "title": "Logs D — même fenêtre temporelle (pas une trace précise)",
              "url": "/d/cloudstore-service-d?${__url_time_range}&var-trace_id=&viewPanel=9",
              "targetBlank": false
            }
          ],
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "SLO availability ≥99.9%",
      "description": "1 = objectif démo respecté ; 0 = dépassé ; absence = non évaluable.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(min(avg_over_time(up{job=\"service-d-payment\"}[30d]))) >= bool 0.999",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "Pas de données / trafic insuffisant",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Dépassé",
                  "color": "red"
                },
                "1": {
                  "text": "Respecté",
                  "color": "green"
                }
              }
            }
          ],
          "links": [
            {
              "title": "Logs D — même fenêtre temporelle (pas une trace précise)",
              "url": "/d/cloudstore-service-d?${__url_time_range}&var-trace_id=&viewPanel=9",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 15,
      "type": "stat",
      "title": "SLO technical errors <1%",
      "description": "1 = objectif démo respecté ; 0 = dépassé ; absence = non évaluable.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 8,
        "y": 44,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
