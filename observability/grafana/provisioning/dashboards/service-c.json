{
  "uid": "service-c-order-dashboard",
  "title": "Service C - Order (RED, SLO & Logs)",
  "tags": ["cloudstore", "service-c", "order"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "SLO Availability (Target: 99.9%)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 5 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "100 * (1 - ((sum(rate(http_requests_total{job=\"service-c-order\", status_code=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_requests_total{job=\"service-c-order\"}[5m])), 0.0001)))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 95,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 99 },
              { "color": "green", "value": 99.9 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "SLO Latency p95 (Target: < 200ms)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 5 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"service-c-order\"}[5m])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.15 },
              { "color": "red", "value": 0.2 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Rate : requêtes/s par route",
      "gridPos": { "x": 0, "y": 5, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "sum by (route) (rate(http_requests_total{job=\"service-c-order\"}[1m]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Errors : erreurs/s par code (4xx / 5xx)",
      "gridPos": { "x": 8, "y": 5, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "sum by (status_code) (rate(http_requests_total{job=\"service-c-order\", status_code=~\"[45]..\"}[1m]))",
          "legendFormat": "HTTP {{status_code}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Duration : latence p95 par route",
      "gridPos": { "x": 16, "y": 5, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket{job=\"service-c-order\"}[1m])))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Utilization : Mémoire RSS",
      "gridPos": { "x": 0, "y": 12, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"service-c-order\"}",
          "legendFormat": "RSS Memory",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Utilization : CPU",
      "gridPos": { "x": 8, "y": 12, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{job=\"service-c-order\"}[1m])",
          "legendFormat": "CPU cores",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Saturation : Event Loop Lag (p99)",
      "gridPos": { "x": 16, "y": 12, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "nodejs_eventloop_lag_p99_seconds{job=\"service-c-order\"}",
          "legendFormat": "p99 lag",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Logs structurés (Service C - Order)",
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 7 },
      "datasource": { "type": "loki" },
      "targets": [
        {
          "expr": "{service_name=\"service-c-order\"}",
          "refId": "A"
        }
      ]
    }
  ]
}
